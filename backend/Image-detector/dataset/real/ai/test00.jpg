<script>
function copyToClipboard(element) { 
  var $temp = $("<input>");
  $("body").append($temp);
  $temp.val($(element).text()).select();
  document.execCommand("copy");
  $temp.remove();}
</script>

<script>
        const pageLink = encodeURI(window.location.href);
        const pageDes = encodeURIComponent(document.querySelector('meta[name="description"]').content);
        const pageTit = encodeURIComponent(document.querySelector('title').textContent);

        const fb1 = document.querySelector('.facebook1');
        fb1.href = 'https://www.facebook.com/sharer/sharer.php?u=' + pageLink;
        const twitter1 = document.querySelector('.twitter1');
        twitter1.href = 'https://twitter.com/intent/tweet?url=' + pageLink;
        const whatsapp1 = document.querySelector('.whatsapp1');        
        whatsapp1.href = 'https://api.whatsapp.com/send/?text=' + pageLink+'&app_absent=0 ' ; 
        const pinterest1 = document.querySelector('.pinterest1');
        pinterest1.href = "https://pinterest.com/pin/create/button/?url=" + pageLink; 
</script>
 
<script>
function scrollSnap(dir){
    var track = document.getElementById('snapTrack');
    var itemWidth = track.querySelector('.snap-item').offsetWidth;
    track.scrollBy({
        left: dir * itemWidth * 3,
        behavior: 'smooth'
    });
}
</script>
<script>
$(document).ready(function(){

    $(document).on('click', '.view-more', function(){ 
        var $btn = $(this);
        var group = $btn.data('group');
        var $current = $('.more-' + group); 

        $('.view-more').not($btn).each(function(){
            var otherGroup = $(this).data('group');
            $('.more-' + otherGroup).slideUp(200).addClass('more-hidden');
            $(this).text('view more');
        }); 

        if ($current.is(':visible')) {
            $current.slideUp(50, function(){
                $(this).addClass('more-hidden');
            });
            $btn.text('view more »');
        } else {
            $current.removeClass('more-hidden').hide().slideDown(50);
            $btn.text('view less');
        }
    });

});
</script>
<script>
document.getElementById("downloadBtn").addEventListener("click", function(){
    this.style.pointerEvents = "none";
    this.innerText = "Downloaded...";
});
</script>

<script>
function copyUrl() {
    var copyText = document.getElementById("shareUrl");
    var btn = document.getElementById("copyBtn");
    copyText.select();
    copyText.setSelectionRange(0, 99999); 
    document.execCommand("copy");
    btn.innerHTML = "Copied";
    setTimeout(function(){
        btn.innerHTML = "Copy URL";
    }, 2000);
}
</script>
